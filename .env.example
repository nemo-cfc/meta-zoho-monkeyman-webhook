# =========================
# META
# =========================

# Random secret string that YOU choose.
# Put the exact same string into Meta Webhooks > Verify Token.
META_VERIFY_TOKEN=replace-with-random-verify-token

# Token with permission to retrieve leads for the Facebook Page / Instant Form.
META_ACCESS_TOKEN=replace-with-meta-access-token

# Meta App Dashboard > Settings > Basic > App Secret.
META_APP_SECRET=replace-with-meta-app-secret

# Keep configurable because Graph API versions change over time.
META_GRAPH_VERSION=v25.0

# Local/manual POST testing only. Keep false in production.
ALLOW_UNSIGNED_WEBHOOKS=false


# =========================
# ZOHO — MONKEYMAN
# =========================

# Use the values from monkeyman-developer-spec-v3.md.
# Do NOT commit the live values to Git.
ZOHO_CLIENT_ID=replace-with-zoho-client-id
ZOHO_CLIENT_SECRET=replace-with-zoho-client-secret
ZOHO_REFRESH_TOKEN=replace-with-zoho-refresh-token

# Verified in the MonkeyMan spec:
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in/crm/v8
MONKEYMAN_MODULE_API_NAME=monkeyman_paid_leads


# =========================
# FORM ROUTING
# =========================

# Map Meta Instant Form IDs to the MonkeyMan service category.
# Fill these after you give me / obtain the actual Meta Form IDs.
#
# Valid categories from the spec:
# Optimisation, Setup, Migration, Development
#
# Example:
# FORM_ROUTES_JSON={"111111111111":{"serviceCategory":"Optimisation"},"222222222222":{"serviceCategory":"Setup"}}
FORM_ROUTES_JSON={}


# =========================
# EXTRA FIELD ALIASES
# =========================

# Optional. Use only if your actual Meta form question keys differ
# from the aliases already handled in the webhook.
#
# Example:
# EXTRA_FIELD_MAP_JSON={"shop_url":"Existing_Site","product_range":"How_Many_Products"}
EXTRA_FIELD_MAP_JSON={}
